name: Generate Documentation

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  docs:
    runs-on: ubuntu-latest
    steps:
      # 1. Клонируем ваш репозиторий
      - name: Checkout code
        uses: actions/checkout@v4

      # 2. Запускаем Doxygen (исправленный mattnotmitt)
      - name: Run Doxygen
        uses: mattnotmitt/doxygen-action@v1
        with:
          doxyfile-path: './Doxyfile' 

      # 3. Сохраняем готовую документацию как артефакт (исправленный upload-artifact)
      - name: Upload Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: doxygen-docs
          # Убедитесь, что этот путь совпадает с OUTPUT_DIRECTORY в вашем Doxyfile (обычно html или docs/html)
          path: docs/html/ 