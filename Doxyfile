text# Укажите, где лежит ваш код (точка означает текущую папку проекта)
INPUT                  = src

# Разрешите рекурсивный поиск файлов в подпапках
RECURSIVE              = YES

# Укажите папку, куда Doxygen будет складывать готовую документацию
# Для интеграции с GitHub Actions лучше использовать имя 'html' или 'docs'
OUTPUT_DIRECTORY       = docs

# Убедитесь, что генерация HTML включена
GENERATE_HTML          = YES